		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\xf3\x00\x00\x00e\x00\x00\x04\x14\x00\x00\x02\x84\x00\x00\x00\xf4\x00\x00\x00\x84\x00\x00\x04\x13\x00\x00\x02\x83\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x00\xf4\x00\x00\x00\x84\x00\x00\x04\x13\x00\x00\x02\x83', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '# ---- Python Script widget: BARRIDO AUTOMATICO DE PARAMETROS ----\n# Conexion: File -&gt; Python Script.  (en el File widget: churn_90d = target; customer_id y clv_estimado = meta)\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom Orange.classification import TreeLearner, KNNLearner, LogisticRegressionLearner\nfrom Orange.evaluation import CrossValidation, TestOnTrainingData, AUC\n\ndata = in_data\ndef auc_cv(learner):      # AUC en datos que el modelo NO vio (validacion cruzada, 5 pliegues)\n    return AUC(CrossValidation(k=5, random_state=0)(data, [learner]))[0]\ndef auc_train(learner):   # AUC en los mismos datos con los que se entreno\n    return AUC(TestOnTrainingData()(data, [learner]))[0]\n\n# --- Experimento 1: profundidad maxima del arbol -------------------------------\nprofundidades = [1, 2, 3, 4, 5, 6, 8, 10, 15, 30]\ntr, cv = [], []\nfor d in profundidades:\n    L = TreeLearner(max_depth=d, min_samples_leaf=50, min_samples_split=5)\n    tr.append(auc_train(L)); cv.append(auc_cv(L))\n    print(f"max_depth={d:&gt;3}  AUC entrenamiento={tr[-1]:.3f}  AUC validacion={cv[-1]:.3f}")\nmejor = profundidades[int(np.argmax(cv))]\nprint(f"\\n&gt;&gt;&gt; Mejor profundidad: {mejor}  (AUC validacion {max(cv):.3f})")\nprint(f"&gt;&gt;&gt; Con el valor por defecto (profundidad 100) el AUC de validacion cae a ~{cv[-1]:.3f}\\n")\n\n# --- Experimento 2: k vecinos en kNN --------------------------------------------\nks = [1, 3, 5, 10, 20, 50, 100, 200]\nkc = []\nfor k in ks:\n    kc.append(auc_cv(KNNLearner(n_neighbors=k)))\n    print(f"k={k:&gt;3}  AUC validacion={kc[-1]:.3f}")\nprint(f"\\n&gt;&gt;&gt; Mejor k: {ks[int(np.argmax(kc))]}")\n\n# --- Experimento 3: regularizacion C en regresion logistica -----------------------\nCs = [0.001, 0.01, 0.1, 1, 10]\nlc = [auc_cv(LogisticRegressionLearner(C=c)) for c in Cs]\nfor c, a in zip(Cs, lc): print(f"C={c:&lt;6} AUC validacion={a:.3f}")\n\n# --- Graficas --------------------------------------------------------------------\nfig, ax = plt.subplots(1, 3, figsize=(14, 4))\nax[0].plot(profundidades, tr, \'o--\', label=\'entrenamiento\'); ax[0].plot(profundidades, cv, \'o-\', label=\'validacion\')\nax[0].set_title(\'Arbol: profundidad\'); ax[0].set_xlabel(\'max_depth\'); ax[0].set_ylabel(\'AUC\'); ax[0].legend()\nax[1].plot(ks, kc, \'o-\'); ax[1].set_xscale(\'log\'); ax[1].set_title(\'kNN: numero de vecinos\'); ax[1].set_xlabel(\'k\')\nax[2].plot(Cs, lc, \'o-\'); ax[2].set_xscale(\'log\'); ax[2].set_title(\'Logistica: C\'); ax[2].set_xlabel(\'C\')\nfor a in ax: a.grid(alpha=.3)\nplt.tight_layout(); plt.show()', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="13" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1a\x00\x00\x00I\x00\x00\x04;\x00\x00\x02h\x00\x00\x01\x1b\x00\x00\x00h\x00\x00\x04:\x00\x00\x02g\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1b\x00\x00\x00h\x00\x00\x04:\x00\x00\x02g', 'scriptLibrary': [{'name': 'Table from numpy', 'script': '# ---- Python Script widget: ¿A CUANTOS CLIENTES CONTACTAR? (conecta churn con CLV) ----\n# Conexion: File -&gt; Python Script.  Supuestos de negocio (cambien y vean que pasa):\nCOSTO_CONTACTO = 30.0    # US$ por cliente contactado (cupon + envio)\nTASA_SALVADO   = 0.25    # de los que se iban y contactamos, 25% se queda\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom Orange.classification import TreeLearner, LogisticRegressionLearner\nfrom Orange.evaluation import CrossValidation\n\ndata = in_data\nclv = data.metas[:, [v.name for v in data.domain.metas].index(\'clv_estimado\')].astype(float)\ny = (data.Y == list(data.domain.class_var.values).index(\'si\')).astype(float)\nn = len(y)\n\ndef curva(learner):\n    res = CrossValidation(k=5, random_state=0)(data, [learner])\n    p = res.probabilities[0][:, list(data.domain.class_var.values).index(\'si\')]\n    orden = res.row_indices[np.argsort(-p)]            # de mayor a menor riesgo\n    ganancia = np.cumsum(y[orden] * TASA_SALVADO * clv[orden] - COSTO_CONTACTO)\n    return ganancia\n\nfig, ax = plt.subplots(figsize=(8, 4.5)); x = np.arange(1, n + 1) / n * 100\nfor nombre, L in [(\'Logistica\', LogisticRegressionLearner(C=1)),\n                  (\'Arbol profundidad 4\', TreeLearner(max_depth=4, min_samples_leaf=2, min_samples_split=5)),\n                  (\'Arbol por defecto (100)\', TreeLearner(max_depth=100, min_samples_leaf=2, min_samples_split=5))]:\n    g = curva(L); i = int(np.argmax(g))\n    print(f"{nombre:&lt;26} mejor corte: contactar {x[i]:.0f}% de la base -&gt; ganancia US$ {g[i]:,.0f}")\n    ax.plot(x, g, label=nombre)\nax.axhline(0, color=\'k\', lw=.8); ax.set_xlabel(\'% de la base contactada (de mayor a menor riesgo)\')\nax.set_ylabel(\'Ganancia acumulada (US$)\'); ax.legend(); ax.grid(alpha=.3); ax.set_title(\'Elegir el corte tambien es un parametro\')\nplt.tight_layout(); plt.show()', 'filename': None}], 'scriptText': '# ---- Python Script widget: ¿A CUANTOS CLIENTES CONTACTAR? (conecta churn con CLV) ----\n# Conexion: File -&gt; Python Script.  Supuestos de negocio (cambien y vean que pasa):\nCOSTO_CONTACTO = 30.0    # US$ por cliente contactado (cupon + envio)\nTASA_SALVADO   = 0.25    # de los que se iban y contactamos, 25% se queda\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom Orange.classification import TreeLearner, LogisticRegressionLearner\nfrom Orange.evaluation import CrossValidation\n\ndata = in_data\nclv = data.metas[:, [v.name for v in data.domain.metas].index(\'clv_estimado\')].astype(float)\ny = (data.Y == list(data.domain.class_var.values).index(\'si\')).astype(float)\nn = len(y)\n\ndef curva(learner):\n    res = CrossValidation(k=5, random_state=0)(data, [learner])\n    p = res.probabilities[0][:, list(data.domain.class_var.values).index(\'si\')]\n    orden = res.row_indices[np.argsort(-p)]            # de mayor a menor riesgo\n    ganancia = np.cumsum(y[orden] * TASA_SALVADO * clv[orden] - COSTO_CONTACTO)\n    return ganancia\n\nfig, ax = plt.subplots(figsize=(8, 4.5)); x = np.arange(1, n + 1) / n * 100\nfor nombre, L in [(\'Logistica\', LogisticRegressionLearner(C=1)),\n                  (\'Arbol profundidad 4\', TreeLearner(max_depth=4, min_samples_leaf=2, min_samples_split=5)),\n                  (\'Arbol por defecto (100)\', TreeLearner(max_depth=100, min_samples_leaf=2, min_samples_split=5))]:\n    g = curva(L); i = int(np.argmax(g))\n    print(f"{nombre:&lt;26} mejor corte: contactar {x[i]:.0f}% de la base -&gt; ganancia US$ {g[i]:,.0f}")\n    ax.plot(x, g, label=nombre)\nax.axhline(0, color=\'k\', lw=.8); ax.set_xlabel(\'% de la base contactada (de mayor a menor riesgo)\')\nax.set_ylabel(\'Ganancia acumulada (US$)\'); ax.legend(); ax.grid(alpha=.3); ax.set_title(\'Elegir el corte tambien es un parametro\')\nplt.tight_layout(); plt.show()', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
